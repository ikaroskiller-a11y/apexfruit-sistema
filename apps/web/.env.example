# Copiar a .env (npm/prisma no versionan .env por defecto).
# Para desarrollo local, SQLite ya funciona sin tocar nada:
DATABASE_URL="file:./dev.db"

# Clave para firmar la cookie de sesión (JWT, ver src/lib/session.ts).
# Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
