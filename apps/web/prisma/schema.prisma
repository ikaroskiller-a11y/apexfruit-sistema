// Esquema de datos - Apex Fruit SPA
// Sistema interno de inspección y control de calidad de fruta de exportación
// (manzana, uva de mesa, cereza, arándano - Región del Maule)
//
// Motor: Postgres (Neon, vía Vercel Marketplace), compartido entre
// desarrollo local y producción — ver README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Usuarios y roles
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMINISTRADOR
  INSPECTOR
}

// Estructura base para autenticación. Por ahora no hay lógica de login real
// (ver src/lib/auth.ts, es un stub) pero el modelo ya soporta credenciales
// hasheadas para cuando se implemente.
model Usuario {
  id            String     @id @default(cuid())
  nombre        String
  email         String     @unique
  passwordHash  String?
  rol           RolUsuario @default(INSPECTOR)
  activo        Boolean    @default(true)
  telefono      String?
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  inspecciones Inspeccion[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Clientes / exportadoras
// ---------------------------------------------------------------------------

model Cliente {
  id            String   @id @default(cuid())
  nombre        String
  rut           String?  @unique
  contacto      String?
  email         String?
  telefono      String?
  direccion     String?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  lotes Lote[]

  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Productores (huertos) — dueños de la fruta antes del packing. Distinto de
// Cliente (exportadora) y de Lote.ubicacionPacking (centro de acopio donde
// se inspecciona): un mismo productor puede despachar a varios packings, y
// un packing recibe de varios productores, así que no se fusionan.
// ---------------------------------------------------------------------------

model Productor {
  id            String   @id @default(cuid())
  nombre        String
  rut           String?  @unique
  contacto      String?
  email         String?
  telefono      String?
  direccion     String?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  lotes Lote[]

  @@map("productores")
}

// ---------------------------------------------------------------------------
// Lotes / partidas de fruta
// ---------------------------------------------------------------------------

enum EspecieFruta {
  MANZANA
  UVA_DE_MESA
  CEREZA
  ARANDANO
  PERA
  KIWI
  CIRUELA
  OTRO
}

// Mercado de destino de exportación. De esto dependen exigencias reales
// (firmeza mínima de kiwi, certificaciones, etc. — ver src/lib/normas.ts).
enum MercadoDestino {
  USA
  EUROPA
  JAPON
  COREA
  CHINA
  INDIA
  LATAM
  OTRO
}

model Lote {
  id                String       @id @default(cuid())
  codigo            String       @unique // folio/código interno de partida
  especie           EspecieFruta
  variedad          String // ej: Gala, Fuji, Lapins, Santina, Duke, Thompson Seedless
  ubicacionPacking  String // packing / centro de acopio donde se inspecciona
  temporada         String // ej: "2025-2026"
  fechaCosecha      DateTime?
  fechaIngreso      DateTime     @default(now())
  cajasTotales      Int?
  kgTotales         Float?
  calibrePredominante String?
  mercadoDestino    MercadoDestino? // mercado de destino de exportación
  notas             String?
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  productorId  String
  productorRef Productor @relation(fields: [productorId], references: [id])

  inspecciones Inspeccion[]

  @@index([clienteId])
  @@index([productorId])
  @@index([especie])
  @@map("lotes")
}

// ---------------------------------------------------------------------------
// Inspecciones de calidad
// ---------------------------------------------------------------------------

// Resultado final de la inspección, en la terminología real de 3 niveles
// que usa Apex Fruit (no "aprobado/rechazado" genérico).
enum ResultadoInspeccion {
  CATEGORIA_1
  CATEGORIA_2
  OBJETADO
}

// Unidad de medida de firmeza: cada especie usa un instrumento/unidad
// distinta en la operación real (manzana/pera -> kgF con penetrómetro,
// cereza -> grados Durofel, kiwi -> libras).
enum FirmezaUnidad {
  KGF
  UD_DUROFEL
  LBS
}

// Etapa del proceso de packing en que ocurrió la inspección (ver
// docs/research/estandares-defectos-calidad.md §1 y §7): un lote pasa por
// varias inspecciones en distintos puntos del flujo, no una sola.
enum EtapaInspeccion {
  RECEPCION
  PRESIZER
  POST_HIDROENFRIADO
  PRE_DESPACHO
}

model Inspeccion {
  id        String          @id @default(cuid())
  fecha     DateTime        @default(now())
  etapa     EtapaInspeccion @default(RECEPCION)

  // Parámetros de calidad
  calibre        String? // ej: "70-75mm", "J", "XL", "Pre" (cereza)
  color          String? // descripción libre de color (manzana/pera/kiwi)
  colorPorcentajeDark Int? // % Dark de la muestra (0-100, solo cereza)
  colorPorcentajeLight Int? // % Light de la muestra (0-100, solo cereza)
  firmeza        Float? // valor de firmeza en la unidad de firmezaUnidad
  firmezaUnidad  FirmezaUnidad? // unidad del valor de `firmeza`
  brixGrados     Float? // sólidos solubles (°Brix)
  acidez         Float? // g ácido málico/cítrico por 100ml (opcional)
  pesoMuestraKg  Float?
  muestraCajas   Int? // n° de cajas muestreadas
  muestraUnidades Int? // n° de unidades/frutos muestreados

  // Control de hidroenfriado (solo cereza) — sección propia de la plantilla
  // real de campo. Ver Manual_Inspeccion_ApexFruit_FINAL (docs/research).
  hidrocoolerTempAguaC             Float? // tolerancia real: 0-2°C
  hidrocoolerCloroLibrePpm         Float? // tolerancia real: 100-120 ppm
  hidrocoolerTiempoExposicionMin   Float? // tolerancia real: 3-5 min
  hidrocoolerTempPulpaPostC        Float?
  hidrocoolerEsperaMasDeUnaHora    Boolean? // true si esperó > 1h antes del hidrocooler

  // Control de presizer (solo etapa PRESIZER) — calibrado óptico
  // automatizado. Distribución de calibre/color queda como texto libre a
  // propósito (evita un sub-CRUD de "distribución por calibre" bajo presión
  // de tiempo). Brix/firmeza de sensores NIR NO se duplican acá: reusan
  // brixGrados/firmeza de arriba.
  presizerNumeroBin             String? // n° de bin de entrada, trazabilidad
  presizerDistribucionCalibres  String? // resumen libre, ej. "24:10%, 28:25%, 32:40%..."
  presizerDistribucionColor     String? // resumen libre por categoría de color
  presizerFalsoRechazoPct       Float? // % fruta buena que fue a descarte por error
  presizerFalsoAceptadoPct      Float? // % fruta con defecto grave que la máquina no detectó
  presizerImpactosNuevosPct     Float? // % con daño mecánico nuevo de la línea
  presizerPerdidaPedicelo       String? // texto libre (ej. "%" o nota) — pérdida de pedicelo en el proceso hidromecánico

  porcentajeRechazo Float? // % de rechazo total de la muestra
  resultado         ResultadoInspeccion @default(CATEGORIA_1)
  informeEnviado    Boolean             @default(false) // true cuando el informe/reporte ya se envió al cliente
  observaciones     String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  loteId String
  lote   Lote   @relation(fields: [loteId], references: [id], onDelete: Cascade)

  inspectorId String
  inspector   Usuario @relation(fields: [inspectorId], references: [id])

  defectos Defecto[]
  fotos    Foto[]
  muestras Muestra[]

  @@index([loteId])
  @@index([inspectorId])
  @@index([fecha])
  @@map("inspecciones")
}

// ---------------------------------------------------------------------------
// Muestras individuales dentro de una inspección
// ---------------------------------------------------------------------------

// Calidad dominante de una muestra puntual, derivada de sus propios
// defectos (ver clasificarMuestra en src/lib/normas.ts) — mismo patrón que
// ResultadoInspeccion para el resultado de cereza a nivel de inspección
// completa, pero aplicado a una muestra individual.
enum CalidadMuestra {
  A
  B
  C
}

model Muestra {
  id     String @id @default(cuid())
  numero Int // correlativo dentro de la inspección (1, 2, 3, ...), autogenerado — el inspector nunca lo escribe. Folio visible = `${lote.codigo}-M${numero}`.

  embalaje String // tipo de embalaje (texto libre en el MVP) — agrupa las muestras en tabs en la UI

  etiqueta        String?
  calibre         String?
  nFrutos         Int?
  pesoKg          Float?
  nSalida         String?
  embaladora      String?
  sinPLU          Int?
  conPLU          Int?
  sobreCalibrePct Float?
  bajoCalibrePct  Float?
  notaApertura    String?
  notaEmbalaje    String?
  hora            String? // hora de registro en terreno, formato libre "HH:mm" — no se valida como DateTime real para no complicar el flujo rápido

  // Derivados de los defectos propios de esta muestra (clasificarMuestra en
  // src/lib/normas.ts) — recalculados cada vez que se guardan sus defectos,
  // nunca ingresados a mano. Umbrales PROVISIONALES, ver comentario en
  // normas.ts: pendientes de validar con el dueño.
  calidad        CalidadMuestra @default(A)
  condicion      Int            @default(1) // 1 (mejor) a 3 (peor)
  causaCalidad   String?
  causaCondicion String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  defectos Defecto[]
  fotos    Foto[]

  @@unique([inspeccionId, numero])
  @@index([inspeccionId])
  @@map("muestras")
}

// ---------------------------------------------------------------------------
// Defectos detectados en una inspección
// ---------------------------------------------------------------------------

// Catálogo real de defectos de cereza (plantilla de campo Apex Fruit):
// 5 de CALIDAD + 10 de CONDICIÓN (ver categoriaDefecto en src/lib/normas.ts
// para la clasificación y src/lib/labels.ts para las etiquetas). Los
// valores al final del enum ya no representan defectos activos de las 4
// especies del demo pero se mantienen para no romper referencias.
enum TipoDefecto {
  // --- CALIDAD (cereza) ---
  RUSSET
  FUERA_DE_COLOR
  AUSENCIA_PEDICELO
  DEFORME // "Frutos deformes"
  MANCHA // "Manchas"

  // --- CONDICIÓN (cereza) ---
  SOBREMADURO // "Sobremadurez"
  PARTIDURA_CRACKING // "Partiduras"
  HERIDA_ABIERTA
  PUDRICION_HUMEDA
  PUDRICION_SECA
  PITTING
  MAGULLADURA // "Machucón"
  PEDICELO_SECO // "Pedicelo deshidratado"
  MEDIALUNA // "Medialunas"
  QUEMADURA_SOL // "Golpe de sol"

  // --- compartidos entre especies / legado ---
  // RUSSET, DEFORME, MANCHA, PARTIDURA_CRACKING, PITTING, MAGULLADURA,
  // DANO_INSECTO y DANO_GRANIZO (arriba/abajo) también se usan para
  // manzana/pera/kiwi: son el mismo defecto físico, ver
  // src/lib/normas.ts#defectosPorEspecie.
  DANO_INSECTO
  INMADURO
  DANO_GRANIZO
  DESGRANE // uva de mesa
  BLANDURA // "Ablandamiento (pérdida de firmeza)" — softening fisiológico, kiwi
  OTRO

  // --- Catálogo ampliado manzana/pera/kiwi (ver
  // docs/research/estandares-defectos-calidad.md §4, USDA/UNECE/UC Davis) ---

  // Daño mecánico
  CORTE_HERIDA // Skin break / cut — todas
  ROCE_RAMA // Limb/leaf rub — manzana, pera, kiwi

  // Plagas / insectos
  PICADURA_INSECTO_SANA // Healed insect sting — manzana, pera, kiwi
  PERFORACION_GUSANO // Worm hole (codling moth) — manzana, pera, kiwi
  DANO_ACARO // Blister mite injury — pera
  DANO_ESCAMA // Scale damage — kiwi, manzana

  // Pudriciones postcosecha (hongos)
  PUDRICION_AZUL // Blue mold (Penicillium) — manzana, pera
  PUDRICION_GRIS // Gray mold (Botrytis) — manzana, pera, kiwi
  PUDRICION_AMARGA // Bitter rot (Colletotrichum) — manzana
  PUDRICION_MUCOR // Mucor rot — manzana
  PUDRICION_PEDUNCULAR // Stem-end rot — kiwi

  // Desórdenes fisiológicos
  BITTER_PIT // Picado amargo — manzana
  ESCALDADO_SUPERFICIAL // Superficial scald — manzana, pera
  ESCALDADO_SENESCENTE // Senescent scald — pera
  CORAZON_ACUOSO // Watercore — manzana
  MANCHA_CORCHOSA_ANJOU // Anjou cork spot — pera
  DEGENERACION_PULPA // Core breakdown — pera
  DANO_FRIO // Chilling injury — kiwi

  // Forma, color y calibre
  DEFECTO_COLOR // Color insuficiente para el grado/variedad — manzana
  FRUTA_APLANADA // Flattened fruit — kiwi
  MARCHITAMIENTO // Shriveling — kiwi
}

model Defecto {
  id         String      @id @default(cuid())
  tipo       TipoDefecto
  cantidad   Int? // n° de unidades afectadas en la muestra
  porcentaje Float? // % sobre la muestra
  esCritico  Boolean     @default(false) // defecto de rechazo directo
  notas      String?

  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  muestraId String?
  muestra   Muestra? @relation(fields: [muestraId], references: [id], onDelete: Cascade)

  @@index([inspeccionId])
  @@index([muestraId])
  @@map("defectos")
}

// ---------------------------------------------------------------------------
// Fotos asociadas a una inspección
// ---------------------------------------------------------------------------

model Foto {
  id           String   @id @default(cuid())
  url          String // ruta local (/uploads/..) o URL externa
  descripcion  String?
  subidaEn     DateTime @default(now())

  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  muestraId String?
  muestra   Muestra? @relation(fields: [muestraId], references: [id], onDelete: Cascade)

  @@index([inspeccionId])
  @@index([muestraId])
  @@map("fotos")
}
